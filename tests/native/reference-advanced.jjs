var Files=Java.type('java.nio.file.Files'),Paths=Java.type('java.nio.file.Paths'),Known=Java.type('csk.taprats.tile.KnownTilings'),Proto=Java.type('csk.taprats.app.Prototype'),Infer=Java.type('csk.taprats.app.Infer'),Feature=Java.type('csk.taprats.tile.Feature'),Point=Java.type('csk.taprats.geometry.Point');
var infer=new Infer(new Proto(Known.getTilings().nextElement())),out=[];
function pt(p){return{x:p.getX(),y:p.getY()};}function lines(map){var a=[],es=map.getEdges();while(es.hasMoreElements()){var e=es.nextElement();a.push({a:pt(e.getV1().getPosition()),b:pt(e.getV2().getPosition())});}return a;}
[4,5,6,8].forEach(function(n){var pts=Java.from(new Feature(n).getPoints()).map(function(p,i){return new Point(p.getX()*1.3+p.getY()*.13,p.getY()*(i===1?.8:1));}),f=new Feature(Java.to(pts,'csk.taprats.geometry.Point[]')),t=new (Java.type('csk.taprats.tile.Tiling'))('fixture',new Point(5,0),new Point(0,5));t.add(f,Java.type('csk.taprats.geometry.Transform').IDENTITY);infer=new Infer(new Proto(t));['star','rosette','hourglass','girih','intersect','progressive'].forEach(function(kind){[1,2,3].forEach(function(s){[1.5,2.25].forEach(function(d){var map;try{if(kind==='star')map=infer.inferStar(f,d,s);else if(kind==='rosette')map=infer.inferRosette(f,.25,s,.4);else if(kind==='hourglass')map=infer.inferHourglass(f,d,s);else if(kind==='girih')map=infer.inferGirih(f,10,d);else if(kind==='intersect')map=infer.inferIntersect(f,10,d,s);else map=infer.inferIntersectProgressive(f,10,d,s);out.push({kind:kind,points:pts.map(pt),d:d,s:s,q:.25,r:.4,n:10,lines:lines(map)});}catch(e){print('skip '+kind+' '+n+' '+s+' '+d+' '+e);}});});});});
